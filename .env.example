# Initial local preview flavor (overridden by the in-browser Dev/Staging switch).
# Prefer `npm run preview` — then use the banner control to switch.
NEXT_PUBLIC_PREVIEW_MODE=dev

# Optional staging credential gate (when Staging is selected).
# If unset, staging accepts any non-empty email + password.
# STAGING_LOGIN_EMAIL=you@school.edu
# STAGING_LOGIN_PASSWORD=changeme
